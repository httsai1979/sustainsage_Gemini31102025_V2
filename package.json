{
  "name": "sustainsage-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next .turbo node_modules",
    "reinstall": "npm run clean && npm ci",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest",
    "check:risk": "node scripts/check-content-risk.mjs",
    "check:site": "node scripts/generate-sitemap.js && node scripts/validate-site-structure.mjs",
    "check:all": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run check:md-links && npm run check:risk && npm run check:site && npm run build",
    "content:check": "node scripts/content-manager.mjs --check",
    "check:defaultprops": "node scripts/check-default-props.js",
    "postbuild": "node scripts/generate-sitemap.js",
    "check:md-links": "node scripts/validate-internal-links.mjs"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.5",
    "@phosphor-icons/react": "^2.1.10",
    "contentful": "^10.15.1",
    "i18next": "^23.16.8",
    "next": "14.2.5",
    "next-i18next": "^15.4.2",
    "next-seo": "^7.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^14.1.3",
    "resend": "^6.4.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.2.5"
  }
}
